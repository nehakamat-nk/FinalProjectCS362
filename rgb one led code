#include <Wire.h>

#define I2C_ADDRESS 0x08

// PWM output pins for RGB LED
const int redPin = 9;
const int greenPin = 10;
const int bluePin = 11;


// Color values
int redValue = 0;
int greenValue = 0;
int blueValue = 0;
int purpleValue = 0;



void setup() {
  Wire.begin(I2C_ADDRESS);
  Wire.onReceive(receiveEvent);

  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);

  digitalWrite(redPin, LOW);
  digitalWrite(greenPin, LOW);
  digitalWrite(bluePin, LOW);

  // Color values
  redValue = map(0,0,0,0,255);
  greenValue = map(0,0,0,0,255);
  blueValue = map(0,0,0,0,255);
  purpleValue = map(0,0,0,0,255);
}

void writeColor(int red, int green, int blue)
{
  analogWrite(greenPin, green);
  analogWrite(redPin, red);
  analogWrite(bluePin, blue);
}

void loop() {
}

void receiveEvent(int howMany) {
  if (Wire.available()) {
    int led = Wire.read();

    digitalWrite(redPin, LOW);
    digitalWrite(greenPin, LOW);
    digitalWrite(bluePin, LOW);

    if (led == 1) writeColor(255, 0, 0);
    else if (led == 2)  writeColor(0, 255, 0);
    else if (led == 3)  writeColor(0, 0, 255);
    else if (led == 4)  writeColor(165, 0, 165);

  }
}
