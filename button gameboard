/*
 * 
 * This Arduino controls ONE breadboard with:
 * - 4 player buttons (one per player)
 * - 4 player LEDs (lights up when that player wins a round)

 * Hardware Connections:
 * - Player 1: Button on pin 2, LED on pin 3
 * - Player 2: Button on pin 4, LED on pin 5
 * - Player 3: Button on pin 6, LED on pin 7
 * - Player 4: Button on pin 8, LED on pin 9
 * - I2C: SDA (A4), SCL (A5)
 * - Ground: Connect to common ground with all other Arduinos
 */

#include <Wire.h>

// I2C slave address for this Arduino
#define I2C_ADDRESS 0x08

// Button pins - using digital pins with internal pull-up resistors
const int buttonPins[4] = {2, 4, 6, 8};

// LED pins - one for each player (lights up when they win)
const int ledPins[4] = {3, 5, 7, 9};

// Game state variables
volatile bool roundActive = false;           // Whether buttons should be monitored
volatile bool buttonPressed = false;         // Whether any button has been pressed this round
volatile int winningPlayer = -1;             // Which player won (0-3), -1 if none
volatile unsigned long buttonPressTime = 0;  // Time when button was pressed (for reaction time)

// Variables for debouncing
volatile unsigned long lastDebounceTime[4] = {0, 0, 0, 0};
const unsigned long debounceDelay = 50; // 50ms debounce delay
// Startup sequence state machine variables
enum StartupState {
  STARTUP_IDLE,
  STARTUP_LED1,
  STARTUP_LED2,
  STARTUP_LED3,
  STARTUP_LED4,
  STARTUP_PAUSE,
  STARTUP_ALL_ON,
  STARTUP_ALL_OFF,
  STARTUP_DONE
};

StartupState startupState = STARTUP_IDLE;
unsigned long startupTimer = 0;
const unsigned long startupStepTime = 150;  // Time for each LED in sequence

void setup() {
  // Initialize serial for debugging
  Serial.begin(9600);
  Serial.println("Button/LED Board Arduino initialized");
  
  // Configure button pins as inputs with pull-up resistors
  // Buttons connect between pin and ground
  for (int i = 0; i < 4; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
  
  // Configure LED pins as outputs
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW); // Start with all LEDs off
  }
  
  // Initialize I2C as slave
  Wire.begin(I2C_ADDRESS);
  Wire.onReceive(receiveEvent);  // Register receive event handler
  Wire.onRequest(requestEvent);  // Register request event handler
  
  // Start the LED startup sequence (shows system is working)
  startupState = STARTUP_LED1;
  startupTimer = millis();
}

void loop() {
  // Run startup sequence if not done
  if (startupState != STARTUP_DONE) {
    runStartupSequence();
  }
  
  // Only check buttons when a round is active and no winner yet
  if (roundActive && !buttonPressed) {
    checkButtons();
  }
}

/*
 * Non-blocking startup LED sequence using state machine.
 * Lights up each player LED in sequence to show the system is ready.
 * NO DELAY() CALLS - uses millis() timing.
 */
void runStartupSequence() {
  unsigned long currentTime = millis();
  
  switch (startupState) {
    case STARTUP_LED1:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[0], HIGH);
        startupState = STARTUP_LED2;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_LED2:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[1], HIGH);
        startupState = STARTUP_LED3;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_LED3:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[2], HIGH);
        startupState = STARTUP_LED4;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_LED4:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[3], HIGH);
        startupState = STARTUP_PAUSE;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_PAUSE:
      if (currentTime - startupTimer >= 300) {
        turnOffAllLeds();
        startupState = STARTUP_ALL_OFF;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_ALL_OFF:
      if (currentTime - startupTimer >= 200) {
        // Turn all LEDs on for final flash
        for (int i = 0; i < 4; i++) {
          digitalWrite(ledPins[i], HIGH);
        }
        startupState = STARTUP_ALL_ON;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_ALL_ON:
      if (currentTime - startupTimer >= 200) {
        turnOffAllLeds();
        startupState = STARTUP_DONE;
        Serial.println("Startup sequence complete - Ready for game");
      }
      break;
      
    case STARTUP_DONE:
    
      break;
      
    default:
      startupState = STARTUP_DONE;
      break; 
  }
}

/*
 * Checks all player buttons for presses during active rounds.
 * Uses debouncing to prevent false readings.
 * 
 * FIRST BUTTON PRESS WINS THE ROUND
 */
void checkButtons() {
  unsigned long currentTime = millis();
  
  for (int i = 0; i < 4; i++) {
    // Read button state (
    int buttonState = digitalRead(buttonPins[i]);
    
    // Check if button is pressed and enough time has passed for debouncing
    if (buttonState == LOW && (currentTime - lastDebounceTime[i]) > debounceDelay) {
      // Update debounce time
      lastDebounceTime[i] = currentTime;
      
      // Register this button press as the winner
      buttonPressed = true;
      winningPlayer = i; 
      buttonPressTime = currentTime;
      
      // Light up the winning player's LED immediately
      digitalWrite(ledPins[i], HIGH);
      
      // Debug output
      Serial.print("Player ");
      Serial.print(i + 1);
      Serial.println(" pressed first - Winner of this round!");
      
      break; // Exit loop - first press wins, ignore other buttons
    }
  }
}

/*
 * I2C receive event handler.
 * Processes commands from the master LCD Arduino.
 * 
 * Commands received from master:
 * - 'S': Start round - activate button monitoring
 * - 'E': End round - deactivate buttons (winner LED stays on)
 * - 'R': Reset game - clear all state, turn off all LEDs
 * - 'W' + player number (0-3): Light up specific winner LED (for team mode)
 * - 'O': Turn off all LEDs
 */
void receiveEvent(int numBytes) {
  if (Wire.available()) {
    char command = Wire.read();
    
    switch (command) {
      case 'S': // Start round
        startRound();
        Serial.println("Round started - buttons active");
        break;
        
      case 'E': // End round
        endRound();
        Serial.println("Round ended - buttons inactive");
        break;
        
      case 'R': // Reset game
        resetGame();
        Serial.println("Game reset");
        break;
        
      case 'W': // Light up specific winner LED (used for team mode)
        if (Wire.available()) {
          int player = Wire.read();
          if (player >= 0 && player < 4) {
            digitalWrite(ledPins[player], HIGH);
            Serial.print("Winner LED lit for player ");
            Serial.println(player + 1);
          }
        }
        break;
        
      case 'O': // Turn off all LEDs
        turnOffAllLeds();
        Serial.println("All LEDs off");
        break;
        
      default:
        Serial.print("Unknown command: ");
        Serial.println(command);
        break;
    }
  }
}

/*
 * I2C request event handler.
 * Sends button press information to the master when requested.
 * Master uses this to know who won and update scores.
 * 
 * Data sent to master:
 * Byte 1: Winning player number (0-3) or 255 if no winner yet
 */
void requestEvent() {
  if (buttonPressed && winningPlayer >= 0) {
    // Send the winning player number (0-3)
    Wire.write(winningPlayer);
    Serial.print("Sending winner data to master: Player ");
    Serial.println(winningPlayer + 1);
  } else {
    // Send 255 to indicate no winner yet
    Wire.write(255);
  }
}

/*
 * Starts a new round by activating button monitoring.
 * Turns off all LEDs and resets winner state.
 */
void startRound() {
  roundActive = true;
  buttonPressed = false;
  winningPlayer = -1;
  turnOffAllLeds();
}

/*
 * Ends the current round.
 * Deactivates button monitoring but keeps winner LED lit.
 */
void endRound() {
  roundActive = false;
}

/*
 * Resets all game state variables and turns off all LEDs.
 * Used when starting a new game.
 */
void resetGame() {
  roundActive = false;
  buttonPressed = false;
  winningPlayer = -1;
  turnOffAllLeds();
  
  // Reset debounce timers
  for (int i = 0; i < 4; i++) {
    lastDebounceTime[i] = 0;
  }
}

/*
 * Turns off all player LEDs.
 */
void turnOffAllLeds() {
  for (int i = 0; i < 4; i++) {
    digitalWrite(ledPins[i], LOW);
  }
}




