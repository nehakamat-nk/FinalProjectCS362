#include <Wire.h>

// I2C slave address for this Arduino
#define I2C_ADDRESS 0x08  

#define PLAYER1_NUMBER 1
#define PLAYER2_NUMBER 2

// Button pins - using digital pins with internal pull-up resistors
const int buttonPins[2] = {8, 9};

// LED pins
const int ledPins[2] = {2, 3};
int x = 0;

// Game state variables
volatile bool roundActive = false;
volatile bool buttonPressed = false;
volatile int pressedPlayer = -1;
volatile unsigned long buttonPressTime = 0;

// Variables for debouncing
volatile unsigned long lastDebounceTime[2] = {0, 0};
const unsigned long debounceDelay = 50;

// Startup sequence state machine variables
enum StartupState {
  STARTUP_IDLE,
  STARTUP_LED1,
  STARTUP_LED2,
  STARTUP_PAUSE,
  STARTUP_ALL_ON,
  STARTUP_ALL_OFF,
  STARTUP_DONE
};

StartupState startupState = STARTUP_IDLE;
unsigned long startupTimer = 0;
const unsigned long startupStepTime = 150;

void setup() {
  for (int i = 0; i < 2; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
  
  for (int i = 0; i < 2; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }
  
  Wire.begin(I2C_ADDRESS);
  Wire.onReceive(receiveEvent);
  Wire.onRequest(requestEvent);
  
  startupState = STARTUP_LED1;
  startupTimer = millis();
}

void loop() {
  if (startupState != STARTUP_DONE) {
    runStartupSequence();
  }
  
  //check
  checkButtons();

  if (x==1)
  {
    digitalWrite(ledPins[0], HIGH);
    digitalWrite(ledPins[1], LOW);
  }
   else if (x==2)
  {
    digitalWrite(ledPins[0], LOW);
    digitalWrite(ledPins[1], HIGH);
  }
  else
  {
    digitalWrite(ledPins[0], LOW);
    digitalWrite(ledPins[1], LOW); 
  }
  
}

void runStartupSequence() {
  unsigned long currentTime = millis();
  
  switch (startupState) {
    case STARTUP_LED1:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[0], HIGH);
        startupState = STARTUP_LED2;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_LED2:
      if (currentTime - startupTimer >= startupStepTime) {
        digitalWrite(ledPins[1], HIGH);
        startupState = STARTUP_PAUSE;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_PAUSE:
      if (currentTime - startupTimer >= 300) {
        turnOffAllLeds();
        startupState = STARTUP_ALL_OFF;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_ALL_OFF:
      if (currentTime - startupTimer >= 200) {
        for (int i = 0; i < 2; i++) {
          digitalWrite(ledPins[i], HIGH);
        }
        startupState = STARTUP_ALL_ON;
        startupTimer = currentTime;
      }
      break;
      
    case STARTUP_ALL_ON:
      if (currentTime - startupTimer >= 200) {
        turnOffAllLeds();
        startupState = STARTUP_DONE;
      }
      break;
      
    case STARTUP_DONE:
      break;
      
    default:
      startupState = STARTUP_DONE;
      break;
  }
}

void checkButtons() {
  unsigned long currentTime = millis();
  
  // Check Player 1 button (pin 8)
  int button1State = digitalRead(buttonPins[0]);
  if (button1State == LOW && (currentTime - lastDebounceTime[0]) > debounceDelay) {
    lastDebounceTime[0] = currentTime;
    buttonPressed = true;
    pressedPlayer = 0;
    buttonPressTime = currentTime;
    return;
  }
  
  // Check Player 2 button (pin 9)
  int button2State = digitalRead(buttonPins[1]);
  if (button2State == LOW && (currentTime - lastDebounceTime[1]) > debounceDelay) {
    lastDebounceTime[1] = currentTime;
    buttonPressed = true;
    pressedPlayer = 1;
    buttonPressTime = currentTime;
    return;
  }
}

void receiveEvent(int numBytes) {
  if (Wire.available()) {
    x = Wire.read();
    
    if (x == 'S') {
      startRound();
    }
  }
}

void requestEvent() {
  // Player 1 pressed
  if (buttonPressed && pressedPlayer == 0) {
    Wire.write(PLAYER1_NUMBER);  // Sends 1
  } 
  // Player 2 pressed
  else if (buttonPressed && pressedPlayer == 1) {
    Wire.write(PLAYER2_NUMBER);  // Sends 2
  }
  // No button pressed
  else {
    Wire.write(255);
  }
}

void startRound() {
  roundActive = true;
  buttonPressed = false;
  pressedPlayer = -1;
  turnOffAllLeds();
}

void endRound() {
  roundActive = false;
}

void resetGame() {
  roundActive = false;
  buttonPressed = false;
  pressedPlayer = -1;
  turnOffAllLeds();
  
  for (int i = 0; i < 2; i++) {
    lastDebounceTime[i] = 0;
  }
}

void turnOffAllLeds() {
  for (int i = 0; i < 2; i++) {
    digitalWrite(ledPins[i], LOW);
  }
}
