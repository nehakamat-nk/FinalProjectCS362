#include <Wire.h>

// I2C slave address for this Arduino
#define I2C_ADDRESS 0x08  

// Button pins - using digital pins with internal pull-up resistors
const int buttonPins[2] = {8, 9};

// LED pins
const int ledPins[2] = {2, 3};
int x = 0;

// Variables for debouncing + buttons
volatile unsigned long lastDebounceTime[2] = {0, 0};
const unsigned long debounceDelay = 50;
bool buttonPressed = false;
unsigned long buttonPressTime = 0;

int playerID = 0;

void setup() {
  Serial.begin(9600)
  for (int i = 0; i < 2; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
  
  for (int i = 0; i < 2; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }
  
  Wire.begin(0x08);
  Wire.onReceive(receiveEvent);
  Wire.onRequest(requestEvent);

  digitalWrite(ledPins[0], LOW);
  digitalWrite(ledPins[1], LOW);
}

void loop() {
  //check
  checkButtons();

  if (x==1)
  {
    digitalWrite(ledPins[0], HIGH);
    digitalWrite(ledPins[1], LOW);
  }
   else if (x==2)
  {
    digitalWrite(ledPins[0], LOW);
    digitalWrite(ledPins[1], HIGH);
  }
  else
  {
    digitalWrite(ledPins[0], LOW);
    digitalWrite(ledPins[1], LOW); 
  }
  
}

void checkButtons() {
  unsigned long currentTime = millis();
  
  // Check Player 1 button (pin 8)
  int button1State = digitalRead(buttonPins[0]);
  if (button1State == LOW){
    if((currentTime - lastDebounceTime[0]) > debounceDelay) {
      Serial.println("button1 pressed");
      lastDebounceTime[0] = currentTime;
      buttonPressed = true;
      buttonPressTime = currentTime;
      playerID = 1;
    }
  }
  
  // Check Player 2 button (pin 9)
  int button2State = digitalRead(buttonPins[1]);
  if (button2State == LOW){
    if((currentTime - lastDebounceTime[1]) > debounceDelay) {
      Serial.println("button2 pressed");
      lastDebounceTime[1] = currentTime;
      buttonPressed = true;
      buttonPressTime = currentTime;
      playerID = 2;
    }
  }
}

void receiveEvent(int numBytes) {

  if (Wire.available()) {
    x = Wire.read();
    Serial.println("Event Received");
  }
}

void requestEvent() {
  if(buttonPressed){
    if (playerID == 1) {
    Wire.write(1);  // Sends 1
    buttonPressed = false;
    Serial.println("signal 1 sent");
    } 
    // Player 2 pressed
    else if (playerID == 2) {
      Wire.write(2);  // Sends 2
      buttonPressed = false;
      Serial.println("signal 2 sent");
    }
  }else {
    Wire.write(255);
    Serial.println("signal 255 sent: error");
  }
}
